# Application
APP_NAME=AdEventTracker
APP_VERSION=1.0.0
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/adevent_db

# Redis (use redis-stack for Bloom Filter support)
REDIS_URL=redis://localhost:6379/0

# AI Provider
AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=15

# Rate Limiter
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Bloom Filter
BLOOM_FILTER_CAPACITY=1000000
BLOOM_FILTER_ERROR_RATE=0.01

# Consumer
CONSUMER_BATCH_SIZE=100
FRAUD_ANALYSIS_INTERVAL_MINUTES=60
